{
  "expo": {
    "name": "Hey-Okay",
    "slug": "heyokay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.heyokay.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hey-Okay nutzt deinen Standort, um dich nur vor Lagen in deiner Nähe zu warnen.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Damit Warnungen auch ankommen, wenn die App geschlossen ist. Wir speichern nur deinen letzten Standort – keinen Verlauf.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.heyokay.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ]
    ],
    "scheme": "heyokay",
    "extra": {
      "apiUrl": "http://localhost:8787"
    }
  }
}

{
  "expo": {
    "name": "Hey-Okay",
    "slug": "heyokay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.heyokay.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hey-Okay nutzt deinen Standort, um dich nur vor Lagen in deiner Nähe zu warnen.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Damit Warnungen auch ankommen, wenn die App geschlossen ist. Wir speichern nur deinen letzten Standort – keinen Verlauf.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.heyokay.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ]
    ],
    "scheme": "heyokay",
    "extra": {
      "apiUrl": "https://heyokay.fly.dev",
      "firebaseEnabled": false,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "48b6164f-ab15-4bd1-b348-b4bab0e7f8ea"
      }
    },
    "owner": "florigramlich",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/48b6164f-ab15-4bd1-b348-b4bab0e7f8ea"
    }
  }
}
